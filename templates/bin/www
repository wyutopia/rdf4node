#!/usr/bin/env node

/**
 * Module dependencies.
 */
const {
    tools, WinstonLogger, bootstrap
} = require('../app');
const logger = WinstonLogger(process.env.SRV_ROLE || 'rdf4node');

//
bootstrap().then(result => {
    logger.info(`>>> Bootstrap result: ${tools.inspect(result)}`);
}).catch(err => {
    logger.error(`!!! Bootstrap error! - `, err);
    process.exit(1);
})